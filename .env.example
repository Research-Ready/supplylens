# UC4 Supply Chain — environment variables
# Copy to .env and fill in real values from passwords.kdbx (SupplyChainBaby100!)
# NEVER commit .env to git

# Neo4j (CT114)
NEO4J_URL=http://localhost:7474
NEO4J_BOLT=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME  # KeePass UC4 -> Neo4j

# LangGraph (CT119)
LANGGRAPH_URL=http://localhost:8000

# Browserless
BROWSERLESS_PROD_URL=http://10.0.5.100:3500
BROWSERLESS_ACC_URL=http://10.0.3.106:3500

# Unstructured (CT117)
UNSTRUCTURED_URL=http://10.0.1.117:8000

# Tika (CT115)
TIKA_URL=http://10.0.1.115:9998

# Qdrant (CT102)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=CHANGE_ME  # KeePass UC4 -> Qdrant

# LiteLLM (CT205) — use researcher-llm model, ollama/nomic-embed-text for embeddings
LITELLM_URL=http://localhost:4000
LITELLM_KEY=CHANGE_ME  # KeePass UC4 -> LiteLLM
LLM_MODEL=researcher-llm
EMBED_MODEL=ollama/nomic-embed-text

# Superset (CT206)
SUPERSET_URL=http://10.0.2.206:8088
SUPERSET_USER=admin@research-ready.nl
SUPERSET_PASSWORD=CHANGE_ME  # KeePass UC4 -> Superset

# Metabase (CT202)
METABASE_URL=http://10.0.2.202:3000

# PostgreSQL knopenkonings DB (CT100)
PG_HOST=10.0.1.100
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME  # main KeePass -> postgres_password
PG_DATABASE=knopenkonings

# n8n (CT104)
N8N_URL=http://localhost:5678
N8N_API_KEY=CHANGE_ME  # ssh root@10.0.1.104 "cat /root/.credentials/n8n.txt"

# Langfuse (CT112)
LANGFUSE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=CHANGE_ME  # main KeePass vault -> langfuse_public_key
LANGFUSE_SECRET_KEY=CHANGE_ME  # main KeePass vault -> langfuse_api_key

# Scraping settings
SCRAPE_TIMEOUT_MS=35000
SCRAPE_WAIT_FOR_MS=1000
MAX_SUPPLY_CHAIN_DEPTH=3
